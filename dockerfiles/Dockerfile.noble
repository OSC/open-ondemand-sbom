FROM ubuntu:24.04

ARG OOD_VERSION
ARG OOD_MAJOR_MINOR

LABEL maintainer="travert@osc.edu"
LABEL ood.version="${OOD_VERSION}"
LABEL ood.distro="noble"
LABEL ood.scan="staging"

ENV DEBIAN_FRONTEND=noninteractive

RUN OOD_MM_RE="$(printf '%s' "$OOD_MAJOR_MINOR" | sed 's/\./\\./g')" && \
    apt-get update && \
    apt-get install -y apt-transport-https ca-certificates wget && \
    wget -O /tmp/ondemand-release.deb "https://yum.osc.edu/ondemand/staging/${OOD_MAJOR_MINOR}/ondemand-release-web_${OOD_MAJOR_MINOR}.0-noble_all.deb" && \
    apt-get install -y /tmp/ondemand-release.deb && \
    sed -i "s|ondemand/${OOD_MM_RE}/|ondemand/staging/${OOD_MM_RE}/|g" /etc/apt/sources.list.d/ondemand*.list && \
    apt-get update && \
    apt-get install -y "ondemand=${OOD_VERSION}*" && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/ondemand-release.deb
